# Rename to .env and fill in values
APP_NAME=IndiePulse
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./indiepulse.db
QUEUE_DB=queue.db
LOG_LEVEL=INFO
# OpenAI
OPENAI_API_KEY=
# OAuth client credentials (fill as needed)
VK_CLIENT_ID=
VK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
# Video defaults
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_CRF=20
VIDEO_PRESET=veryfast
