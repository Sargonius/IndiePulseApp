# Copy to .env. Only these variables are read; platform credentials live in
# .settings.json and are edited on the Settings (⚙️) page.
APP_HOST=127.0.0.1
APP_PORT=8000
# Base URL used for OAuth redirect URIs — must match what you registered with
# Google / X / TikTok / VK. Defaults to http://127.0.0.1:<APP_PORT>.
# APP_BASE_URL=http://127.0.0.1:8000
# Extra hostnames allowed in the Host header (comma-separated), e.g. when exposing on LAN.
# ALLOWED_HOSTS=my-pc.local
DATABASE_URL=sqlite:///./indiepulse.db
QUEUE_DB=queue.db
LOG_LEVEL=INFO
# The game of the Steam store-news export lives in Settings → Steam; this only fills it in when that is empty.
# STEAM_APP_ID=
